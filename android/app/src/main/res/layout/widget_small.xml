<?xml version="1.0" encoding="utf-8"?>
<!-- The home screen widget, small (KakeboWidget.kt shows the parts each moment needs): by day what is left and +, in the
     evening the question and 筆, the month to close with its seal. Its texts are the ones shown before the app sends any. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="18dp"
    android:paddingTop="10dp"
    android:paddingEnd="14dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/seal"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/widget_seal"
        android:fontFamily="@font/shippori_mincho"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:rotation="-6"
        android:text="済"
        android:textColor="@color/widget_seal"
        android:textSize="22sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/kicker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="@string/widget_open"
            android:textColor="@color/widget_label"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/shippori_mincho"
            android:maxLines="3"
            android:text="家計簿"
            android:textColor="@color/widget_ink"
            android:textSize="28sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/action"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/widget_circle"
        android:fontFamily="@font/shippori_mincho"
        android:gravity="center"
        android:textColor="@color/widget_on_ink"
        android:textSize="22sp"
        android:visibility="gone" />
</LinearLayout>
